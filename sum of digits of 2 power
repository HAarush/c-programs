#include<iostream>
#include<deque>
using namespace std;
int main()
{
    deque<int> fact{1};
    int prod=0;
    int carry=0;
    int i,x,last;
    int sum=0;
    for(i=2;i<=1000;i++)
    {
        for(x=1;x<=fact.size();x++)
        {
            prod = (fact[fact.size()-x] * 2)+carry;
            last = prod%10;
            carry = prod/10;
            fact[fact.size()-x] = last;
            //fact.push_front(last);
            //carry=0;
        }
        while(carry>0)
        {
            fact.push_front(carry%10);
            carry = carry/10;
        }
    }
    for(int val : fact) 
    {
        sum = sum+val;
    }
    cout<<sum-1;
}
